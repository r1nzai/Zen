{
    "$description": "Zen's design tokens, dark glass (the default theme). Colours are OKLCH: lightness is fixed per role, so contrast holds whatever hue a theme picks; only hue and chroma carry the brand. zen-light.tokens.json overrides them for the light theme.",
    "radius": {
        "radius": { "$type": "dimension", "$value": { "value": 0.625, "unit": "rem" } }
    },
    "surface": {
        "$type": "color",
        "background": { "$value": { "colorSpace": "oklch", "components": [0.155, 0.014, 295] } },
        "foreground": { "$value": { "colorSpace": "oklch", "components": [0.97, 0.004, 295] } },
        "card": { "$value": { "colorSpace": "oklch", "components": [0.195, 0.014, 295] } },
        "card-foreground": { "$value": { "colorSpace": "oklch", "components": [0.97, 0.004, 295] } },
        "popover": { "$value": { "colorSpace": "oklch", "components": [0.21, 0.014, 295] } },
        "popover-foreground": { "$value": { "colorSpace": "oklch", "components": [0.97, 0.004, 295] } }
    },
    "role": {
        "$type": "color",
        "primary": { "$description": "violet", "$value": { "colorSpace": "oklch", "components": [0.72, 0.13, 295] } },
        "primary-foreground": { "$value": { "colorSpace": "oklch", "components": [0.17, 0.03, 295] } },
        "secondary": { "$value": { "colorSpace": "oklch", "components": [0.25, 0.014, 295] } },
        "secondary-foreground": { "$value": { "colorSpace": "oklch", "components": [0.97, 0.004, 295] } },
        "muted": { "$value": { "colorSpace": "oklch", "components": [0.235, 0.014, 295] } },
        "muted-foreground": { "$value": { "colorSpace": "oklch", "components": [0.72, 0.021, 295] } },
        "accent": { "$value": { "colorSpace": "oklch", "components": [0.3, 0.046, 295] } },
        "accent-foreground": { "$value": { "colorSpace": "oklch", "components": [0.88, 0.065, 295] } },
        "destructive": { "$value": { "colorSpace": "oklch", "components": [0.64, 0.2, 25] } },
        "destructive-foreground": { "$value": { "colorSpace": "oklch", "components": [0.13, 0.02, 25] } }
    },
    "line": {
        "$type": "color",
        "border": { "$value": { "colorSpace": "oklch", "components": [0.28, 0.021, 295] } },
        "input": { "$value": { "colorSpace": "oklch", "components": [0.28, 0.021, 295] } },
        "ring": { "$value": { "colorSpace": "oklch", "components": [0.72, 0.13, 295] } }
    },
    "glow": {
        "$description": "Light that surfaces pick up: focus halos, primary buttons, lit edges.",
        "glow": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.7, 0.13, 295] } },
        "glow-2": {
            "$type": "color",
            "$description": "analogous, a little further round the wheel",
            "$value": { "colorSpace": "oklch", "components": [0.72, 0.098, 325] }
        },
        "glow-strength": { "$type": "number", "$description": "0 turns every glow off", "$value": 0.55 },
        "glow-trail": {
            "$type": "duration",
            "$description": "How far the pointer light trails the pointer, as one light for every glow Backdrop drives; 0ms (the default) follows exactly.",
            "$value": { "value": 0, "unit": "ms" }
        },
        "glow-k": {
            "$type": "number",
            "$description": "Component halos (a checked box, a primary button, a focused field) are tuned at the default strength; their alphas are scaled by this (glow-strength over the strength they were tuned at), so the default looks as designed and 0 turns them off too.",
            "$value": 1,
            "$extensions": { "dev.rinzai.zen": { "tunedAt": 0.55 } }
        }
    },
    "tint": {
        "tint": {
            "$type": "color",
            "$description": "Ink for translucent overlays (hairlines, glass fills, hover tints), used with an alpha: white on dark, deep violet-grey on light.",
            "$value": { "colorSpace": "oklch", "components": [1, 0, 0] }
        }
    },
    "contrast": {
        "$description": "Contrast floors for neutral parts, per theme (internal: no utilities of their own). Edges of unchecked checkboxes, radios and switches reach 3:1 against a card; placeholders reach 4.5:1 while staying clearly dimmer than a typed value.",
        "zen-control-edge": { "$type": "number", "$value": 0.35 },
        "zen-control-edge-hover": { "$type": "number", "$value": 0.5 },
        "zen-placeholder": { "$type": "number", "$value": 0.8 },
        "zen-thumb-off": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [1, 0, 0], "alpha": 0.7 } }
    },
    "depth": {
        "glass-shadow": {
            "$type": "shadow",
            "$value": {
                "color": { "colorSpace": "hsl", "components": [0, 0, 0], "alpha": 0.6 },
                "offsetX": { "value": 0, "unit": "px" },
                "offsetY": { "value": 10, "unit": "px" },
                "blur": { "value": 40, "unit": "px" },
                "spread": { "value": -12, "unit": "px" }
            }
        },
        "popup-shadow": {
            "$type": "shadow",
            "$value": {
                "color": { "colorSpace": "hsl", "components": [0, 0, 0], "alpha": 0.8 },
                "offsetX": { "value": 0, "unit": "px" },
                "offsetY": { "value": 20, "unit": "px" },
                "blur": { "value": 60, "unit": "px" },
                "spread": { "value": -20, "unit": "px" }
            }
        },
        "toast-shadow": {
            "$type": "shadow",
            "$value": {
                "color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.8 },
                "offsetX": { "value": 0, "unit": "px" },
                "offsetY": { "value": 18, "unit": "px" },
                "blur": { "value": 50, "unit": "px" },
                "spread": { "value": -20, "unit": "px" }
            }
        },
        "backdrop-scrim": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.5 } },
        "topo-strength": { "$type": "number", "$value": 0.55 }
    },
    "chart": {
        "$type": "color",
        "$description": "Chart series, in this order. Validated as a set on the dark and light surfaces: lightness band, chroma, colour-blind separation of neighbours, contrast. Assign in order; never cycle past 8.",
        "chart-1": { "$value": { "colorSpace": "srgb", "components": [0.2235, 0.5294, 0.898], "hex": "#3987e5" } },
        "chart-2": { "$value": { "colorSpace": "srgb", "components": [0.851, 0.349, 0.149], "hex": "#d95926" } },
        "chart-3": { "$value": { "colorSpace": "srgb", "components": [0.098, 0.6196, 0.4392], "hex": "#199e70" } },
        "chart-4": { "$value": { "colorSpace": "srgb", "components": [0.7882, 0.5216, 0], "hex": "#c98500" } },
        "chart-5": { "$value": { "colorSpace": "srgb", "components": [0.8353, 0.3176, 0.5059], "hex": "#d55181" } },
        "chart-6": { "$value": { "colorSpace": "srgb", "components": [0, 0.5137, 0], "hex": "#008300" } },
        "chart-7": { "$value": { "colorSpace": "srgb", "components": [0.5647, 0.5216, 0.9137], "hex": "#9085e9" } },
        "chart-8": { "$value": { "colorSpace": "srgb", "components": [0.902, 0.4039, 0.4039], "hex": "#e66767" } }
    }
}
