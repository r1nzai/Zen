{
    "$description": "The light theme: overrides zen.tokens.json, path for path.",
    "surface": {
        "$type": "color",
        "background": { "$value": { "colorSpace": "oklch", "components": [0.985, 0.006, 295] } },
        "foreground": { "$value": { "colorSpace": "oklch", "components": [0.21, 0.02, 295] } },
        "card": { "$value": { "colorSpace": "oklch", "components": [1, 0, 0] } },
        "card-foreground": { "$value": { "colorSpace": "oklch", "components": [0.21, 0.02, 295] } },
        "popover": { "$value": { "colorSpace": "oklch", "components": [1, 0, 0] } },
        "popover-foreground": { "$value": { "colorSpace": "oklch", "components": [0.21, 0.02, 295] } }
    },
    "role": {
        "$type": "color",
        "primary": { "$value": { "colorSpace": "oklch", "components": [0.48, 0.195, 295] } },
        "primary-foreground": { "$value": { "colorSpace": "oklch", "components": [0.985, 0, 0] } },
        "secondary": { "$value": { "colorSpace": "oklch", "components": [0.955, 0.008, 295] } },
        "secondary-foreground": { "$value": { "colorSpace": "oklch", "components": [0.21, 0.02, 295] } },
        "muted": { "$value": { "colorSpace": "oklch", "components": [0.96, 0.007, 295] } },
        "muted-foreground": { "$value": { "colorSpace": "oklch", "components": [0.5, 0.021, 295] } },
        "accent": { "$value": { "colorSpace": "oklch", "components": [0.95, 0.033, 295] } },
        "accent-foreground": { "$value": { "colorSpace": "oklch", "components": [0.42, 0.117, 295] } },
        "destructive": { "$value": { "colorSpace": "oklch", "components": [0.55, 0.22, 25] } },
        "destructive-foreground": { "$value": { "colorSpace": "oklch", "components": [0.985, 0, 0] } }
    },
    "line": {
        "$type": "color",
        "border": { "$value": { "colorSpace": "oklch", "components": [0.91, 0.011, 295] } },
        "input": { "$value": { "colorSpace": "oklch", "components": [0.91, 0.011, 295] } },
        "ring": { "$value": { "colorSpace": "oklch", "components": [0.48, 0.195, 295] } }
    },
    "glow": {
        "glow": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.62, 0.182, 295] } },
        "glow-2": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.65, 0.137, 325] } },
        "glow-strength": { "$type": "number", "$value": 0.4 },
        "glow-k": { "$type": "number", "$value": 1, "$extensions": { "dev.rinzai.zen": { "tunedAt": 0.4 } } }
    },
    "tint": {
        "tint": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.21, 0.02, 295] } }
    },
    "contrast": {
        "zen-control-edge": { "$type": "number", "$value": 0.5 },
        "zen-control-edge-hover": { "$type": "number", "$value": 0.65 },
        "zen-placeholder": { "$type": "number", "$value": 1 },
        "zen-thumb-off": {
            "$type": "color",
            "$description": "A white thumb is lost on the pale track.",
            "$value": { "colorSpace": "oklch", "components": [0.21, 0.02, 295], "alpha": 0.5 },
            "$extensions": { "dev.rinzai.zen": { "of": "{tint.tint}" } }
        }
    },
    "depth": {
        "glass-shadow": {
            "$type": "shadow",
            "$value": {
                "color": { "colorSpace": "oklch", "components": [0.3, 0.05, 295], "alpha": 0.25 },
                "offsetX": { "value": 0, "unit": "px" },
                "offsetY": { "value": 10, "unit": "px" },
                "blur": { "value": 30, "unit": "px" },
                "spread": { "value": -14, "unit": "px" }
            }
        },
        "popup-shadow": {
            "$type": "shadow",
            "$value": {
                "color": { "colorSpace": "oklch", "components": [0.3, 0.05, 295], "alpha": 0.35 },
                "offsetX": { "value": 0, "unit": "px" },
                "offsetY": { "value": 20, "unit": "px" },
                "blur": { "value": 50, "unit": "px" },
                "spread": { "value": -20, "unit": "px" }
            }
        },
        "toast-shadow": {
            "$type": "shadow",
            "$value": {
                "color": { "colorSpace": "oklch", "components": [0.3, 0.05, 295], "alpha": 0.35 },
                "offsetX": { "value": 0, "unit": "px" },
                "offsetY": { "value": 18, "unit": "px" },
                "blur": { "value": 50, "unit": "px" },
                "spread": { "value": -20, "unit": "px" }
            }
        },
        "backdrop-scrim": {
            "$type": "color",
            "$value": { "colorSpace": "oklch", "components": [0.21, 0.02, 295], "alpha": 0.3 }
        },
        "topo-strength": { "$type": "number", "$value": 0.55 }
    },
    "chart": {
        "$type": "color",
        "chart-1": { "$value": { "colorSpace": "srgb", "components": [0.1647, 0.4706, 0.8392], "hex": "#2a78d6" } },
        "chart-2": { "$value": { "colorSpace": "srgb", "components": [0.9216, 0.4078, 0.2039], "hex": "#eb6834" } },
        "chart-3": { "$value": { "colorSpace": "srgb", "components": [0.1059, 0.6863, 0.4784], "hex": "#1baf7a" } },
        "chart-4": { "$value": { "colorSpace": "srgb", "components": [0.9294, 0.6314, 0], "hex": "#eda100" } },
        "chart-5": { "$value": { "colorSpace": "srgb", "components": [0.9098, 0.4824, 0.6431], "hex": "#e87ba4" } },
        "chart-6": { "$value": { "colorSpace": "srgb", "components": [0, 0.5137, 0], "hex": "#008300" } },
        "chart-7": { "$value": { "colorSpace": "srgb", "components": [0.2902, 0.2275, 0.6549], "hex": "#4a3aa7" } },
        "chart-8": { "$value": { "colorSpace": "srgb", "components": [0.8902, 0.2863, 0.2824], "hex": "#e34948" } }
    }
}
