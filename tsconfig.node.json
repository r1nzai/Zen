{
    "compilerOptions": {
        "composite": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "allowArbitraryExtensions": true,
        "resolveJsonModule": true,
        "skipLibCheck": true
    },
    "include": [
        "vite.config.ts",
        "docs/app/pages.ts",
        "docs/app/markdown.ts",
        "docs/app/example-source.ts",
        "playwright.config.ts",
        "e2e/now.ts",
        "package.json"
    ]
}
