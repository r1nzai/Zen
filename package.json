{
    "name": "@rinzai/zen",
    "version": "0.4.1",
    "description": "React components in dark glass: translucent surfaces, hairline borders that catch a pointer light, one accent colour. Tailwind v4, no runtime dependencies.",
    "keywords": [
        "react",
        "react-components",
        "component-library",
        "ui",
        "design-system",
        "tailwind",
        "tailwindcss",
        "tailwind-v4",
        "glassmorphism",
        "dark-mode",
        "oklch",
        "popover-api",
        "dialog",
        "table",
        "virtualized",
        "typescript"
    ],
    "homepage": "https://zen.rinzai.dev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/r1nzai/Zen.git"
    },
    "bugs": {
        "url": "https://github.com/r1nzai/Zen/issues"
    },
    "author": "rinzai (https://github.com/r1nzai)",
    "license": "MIT",
    "type": "module",
    "types": "./dist/index.d.ts",
    "module": "./dist/zen.js",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/zen.js",
            "require": "./dist/zen.js"
        },
        "./css": {
            "import": "./dist/zen.css",
            "require": "./dist/zen.css"
        },
        "./tailwind.css": {
            "style": "./dist/tailwind.css",
            "default": "./dist/tailwind.css"
        },
        "./base.css": {
            "style": "./dist/base.css",
            "default": "./dist/base.css"
        }
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "build": "vite build",
        "lint": "eslint packages/**/*.{ts,tsx}",
        "lint:fix": "eslint --fix packages/**/*.{ts,tsx}",
        "format": "prettier --write packages/**/*.{ts,tsx,css} --config ./.prettierrc",
        "dev": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "prepublishOnly": "npm run build",
        "chromatic": "npx chromatic --project-token $CHROMATIC_PROJECT_TOKEN",
        "docs:dev": "pnpm --filter zen-docs dev",
        "docs:build": "pnpm --filter zen-docs build && cp docs/build/client/404/index.html docs/build/client/404.html && storybook build --output-dir docs/build/client/storybook"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@storybook/addon-a11y": "^10.6.0",
        "@storybook/addon-docs": "^10.6.0",
        "@storybook/addon-links": "^10.6.0",
        "@storybook/addon-themes": "^10.6.0",
        "@storybook/react-vite": "^10.6.0",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@typescript-eslint/parser": "^8.70.1",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/coverage-v8": "^5.0.2",
        "autoprefixer": "^10.6.1",
        "chromatic": "^18.9.5",
        "esbuild": "^0.28.2",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-storybook": "^10.6.0",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "jsdom": "^30.1.1",
        "postcss": "^8.5.28",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "storybook": "^10.6.0",
        "sugar-high": "^2.5.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.1",
        "vite-plugin-dts": "^5.1.1",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^5.0.2"
    },
    "peerDependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "packageManager": "pnpm@10.28.2"
}
